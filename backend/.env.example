# ============================================================
# AI Video Clipper — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# Google Gemini API Key (Gratis di: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis URL untuk Celery Task Queue
# Jika pakai Redis lokal: redis://localhost:6379/0
# Jika pakai Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Celery Broker & Backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Path direktori (relatif dari root projek)
UPLOAD_DIR=../uploads
CLIPS_DIR=../clips

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./videoclipper.db

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Whisper model size (tiny/base/small/medium/large-v3)
# Rekomendasi: "base" untuk PC biasa, "small" untuk hasil lebih akurat
WHISPER_MODEL=base

# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Max clips per video
MAX_CLIPS=5

# Clip duration range (seconds)
CLIP_MIN_DURATION=30
CLIP_MAX_DURATION=90
